config CTR_CLOUD
	bool "CTR_CLOUD"
	depends on SHIELD_CTR_LTE_V2
	select CTR_BUF
	select CTR_INFO
	select CTR_RTC
	select EVENTS
	select PSA_CRYPTO
	select PSA_WANT_ALG_SHA_256
	select ZCBOR
	select ZCBOR_STOP_ON_ERROR
	select SHELL
	select SHELL_BACKEND_DUMMY
	select BASE64

if CTR_CLOUD

module = CTR_CLOUD
module-str = CHESTER CLOUD Subsystem
source "subsys/logging/Kconfig.template.log_config"

config SHELL_BACKEND_DUMMY_BUF_SIZE
	int "SHELL_BACKEND_DUMMY_BUF_SIZE"
	default 8192

config CTR_CLOUD_TRANSFER_BUF_SIZE
	int "Cloud transfer buffer size in bytes"
	default 16384

config CTR_CLOUD_ENCODE_ZCBOR_STATES
	int "Number of zcbor backup states for message encoding"
	default 2
	range 0 32
	help
	  Number of zcbor backup states available to the encoding callback
	  of a data message. Backup states are consumed only by canonical
	  encoding of maps and lists (CONFIG_ZCBOR_CANONICAL), where each
	  level of nesting needs one, and by zcbor_bstr_start_encode().
	  Encoding with indefinite-length maps and lists, as done today,
	  needs none, so the default 2 is just a small reserve.

	  The states are allocated on the stack of the thread calling the
	  send function, not in static RAM: (N + 2) * sizeof(zcbor_state_t),
	  that is 36 bytes per state on 32-bit targets, 144 bytes at the
	  default of 2. Increase the value when sending fails with -ENOMEM
	  (zcbor ran out of backup states: messages nested deeper with
	  canonical encoding or bstr wrapping), decrease it to save stack.

config CTR_CLOUD_CONFIG
	bool

config CTR_CLOUD_SPOOL
	bool "Enable CLOUD message spool"
	select CTR_CLOUD_CONFIG

if CTR_CLOUD_SPOOL

choice
	prompt "CLOUD spool storage backend"
	default CTR_CLOUD_SPOOL_BACKEND_LITTLEFS

config CTR_CLOUD_SPOOL_BACKEND_LITTLEFS
	bool "LittleFS backend"
	select FILE_SYSTEM
	select FILE_SYSTEM_LITTLEFS

endchoice

endif # CTR_CLOUD_SPOOL

endif # CTR_CLOUD
